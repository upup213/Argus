# =============================================================================
# application.yml.example —— 配置模板（键名齐全，敏感值一律为空占位，严禁填入真实值）
#
# 【环境变量清单】（敏感值一律通过环境变量注入，配置文件中只保留无默认值的 ${VAR} 占位符）
# +-----------------------------+--------------------------------------------------------------------+-----------------------------+
# | 环境变量                    | 配置键                                                             | 含义                        |
# +-----------------------------+--------------------------------------------------------------------+-----------------------------+
# | DASHSCOPE_API_KEY           | spring.ai.dashscope.api-key / dashscope.api.key                     | DashScope LLM + Embedding   |
# |                             |                                                                    | 共用密钥                    |
# | APP_API_KEY                 | security.api-key                                                    | 本服务对外 API Key          |
# | MCP_TENCENT_CLS_SSE_ENDPOINT| spring.ai.mcp.client.sse.connections.tencent-cls.sse-endpoint       | MCP SSE 端点（路径含凭证）  |
# | SECURITY_ALLOWED_ORIGINS    | security.allowed-origins                                            | CORS 白名单（逗号分隔来源，  |
# |                             |                                                                    | 非敏感，可空=默认拒绝跨域） |
# | REDIS_HOST                  | spring.data.redis.host                                              | Redis 主机名                |
# | REDIS_PORT                  | spring.data.redis.port                                              | Redis 端口                  |
# | REDIS_PASSWORD              | spring.data.redis.password                                          | Redis 密码（无默认值）      |
# | MILVUS_COLLECTION_NAME      | milvus.collection-name (运行时覆盖)                                 | Milvus 集合名称             |
# | FILE_UPLOAD_PATH            | file.upload.path (运行时覆盖)                                       | 文件上传存储路径             |
# | SESSION_STORE               | session.store (运行时覆盖)                                          | Session 存储后端            |
# +-----------------------------+--------------------------------------------------------------------+-----------------------------+
#
# 说明：所有敏感值一律使用无默认值占位符 ${VAR}，任一环境变量缺失或为空时应用启动即失败（fail-fast）。
#
# -----------------------------------------------------------------------------
# 【密钥轮换操作指引】（旧 Key 视为已泄露，必须轮换；顺序必须"先上新后禁旧"）
#  ① 阿里云百炼/DashScope 控制台 → API-KEY 管理 → 创建新 Key（先不要禁用旧 Key）；
#  ② 部署环境更新 DASHSCOPE_API_KEY 为新 Key 并重启服务；
#  ③ 冒烟验证：上传一个 txt 触发 embedding、调用 /api/chat 完成一次对话；
#  ④ 验证通过后回到控制台禁用/删除旧 Key，并观察告警；
#  ⑤ 腾讯云 MCP 服务侧重新生成 SSE 端点凭证，并更新 MCP_TENCENT_CLS_SSE_ENDPOINT；
#  ⑥ 全盘检索历史交付物中出现过的旧 Key，一律按已泄露处理（含本次轮换前的所有副本）。
# 注意：旧 Key、旧 MCP 端点凭证均已视为泄露；严禁复用旧 Key；严禁将真实值写回本文件或任何入库文件。
# =============================================================================

server:
  port: 9900
  servlet:
    encoding:
      charset: UTF-8
      enabled: true
      force: true

file:
  upload:
    path: ./uploads
    allowed-extensions: txt,md

milvus:
  host: localhost
  port: 19530
  username: ""
  password: ""
  database: default
  timeout: 10000
  # P2 NEW: collection-name can be overridden at runtime via MILVUS_COLLECTION_NAME env var
  #   e.g., milvus.collection-name=${MILVUS_COLLECTION_NAME:-biz}

# Spring AI Alibaba DashScope 配置
spring:
  ai:
    dashscope:
      api-key: ${DASHSCOPE_API_KEY}  # 从环境变量读取，无默认值，缺失时启动失败
      chat:
        options:
          timeout: 180000  # 超时时间180秒（3分钟）
      retry:
        max-attempts: 3  # 最大重试次数
        backoff:
          initial-interval: 2000  # 初始重试间隔2秒
          multiplier: 2  # 重试间隔倍数
          max-interval: 10000  # 最大重试间隔10秒

    # Spring AI MCP 客户端配置
    # 如果使用mock数据，请注释这部分内容
    mcp:
      client:
        enabled: true
        name: tencent-mcp-server
        version: 1.0.0
        request-timeout: 60s
        type: ASYNC
        sse:
          connections:
            tencent-cls:
              url: https://mcp-api.tencent-cloud.com
              sse-endpoint: ${MCP_TENCENT_CLS_SSE_ENDPOINT}  # SSE端点路径（含凭证），从环境变量读取，无默认值

    # P2 NEW: Redis 配置 — Session 存储 & 缓存后端
    data:
      redis:
        host: ${REDIS_HOST:localhost}       # 非敏感，有默认值；compose 中设为 "redis"
        port: ${REDIS_PORT:6379}             # 非敏感，有默认值
        password: ${REDIS_PASSWORD:}         # 敏感，无默认值 — compose 中必须提供

# 阿里云 DashScope Embedding API 配置
dashscope:
  api:
    key: ${DASHSCOPE_API_KEY}  # 从环境变量读取，无默认值（用于自定义配置）
  embedding:
    model: text-embedding-v4  # 阿里云文本向量化模型

# 对外 API Key 鉴权配置（供后续鉴权任务使用）
security:
  api-key: ${APP_API_KEY}  # 从环境变量读取，无默认值，缺失时启动失败
  # CORS 白名单：逗号分隔的允许来源列表（如 https://app.example.com,http://localhost:3000）
  # 用于收紧跨域访问，只允许列表内来源携带 X-API-Key 跨域调用本服务；
  # 为空（默认）= 拒绝一切跨域请求，同源部署不受影响；严禁配置为 *。
  allowed-origins: ${APP_ALLOWED_ORIGINS:}

# 文档分片配置
document:
  chunk:
    max-size: 800  # 每个分片最大字符数
    overlap: 100   # 分片之间的重叠字符数

# RAG 配置
rag:
  top-k: 3  # 检索返回的最相似文档数量
  model: "qwen3-max"  # 大语言模型名称

# Prometheus 配置
prometheus:
  base-url: http://localhost:9090
  timeout: 10  # 超时时间（秒）
  mock-enabled: false  # 是否启用 Mock 模式（用于测试）

# CLS 云日志服务配置
cls:
  mock-enabled: false  # 是否启用 Mock 模式（用于测试，设为 true 返回与告警关联的模拟日志数据）
